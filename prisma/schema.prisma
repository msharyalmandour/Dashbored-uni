// University OS — relational schema
//
// Postgres (Supabase) in every environment. `DATABASE_URL` is the Supavisor
// transaction pooler, which is what the running app uses; `DIRECT_URL` is a
// session-mode connection used only by Prisma's schema tooling (migrate, db
// pull, studio), which cannot run through a transaction pooler. Neither value
// is ever hardcoded here — see .env.example and the README for how to build
// them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum SemesterStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum SubjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LectureStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum ResourceType {
  PDF
  POWERPOINT
  VIDEO
  LINK
  NOTE
}

enum GapSource {
  LECTURE
  CLINICAL_TRAINING
  VIDEO
  PROBLEM_SOLVING
  READING
  OTHER
}

enum GapStatus {
  NOT_UNDERSTOOD
  LEARNING
  PRACTICING
  UNDERSTOOD
  MASTERED
}

enum FlashcardStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
}

enum ReviewType {
  LECTURE
  TOPIC
  FLASHCARD
  KNOWLEDGE_GAP
  MISTAKE
}

enum ReviewStage {
  REVIEW_1
  REVIEW_2
  REVIEW_3
  REVIEW_4
  MASTERY_REVIEW
}

enum ReviewStatus {
  SCHEDULED
  DUE
  COMPLETED
  SKIPPED
}

enum ProblemStatus {
  NOT_ATTEMPTED
  CORRECT
  INCORRECT
  NEEDS_RETRY
}

enum MistakeType {
  KNOWLEDGE_GAP
  MISUNDERSTANDING
  MEMORY_ERROR
  CARELESS_MISTAKE
  QUESTION_MISINTERPRETATION
}

enum MistakeStatus {
  OPEN
  REVIEWING
  RESOLVED
}

enum VideoStatus {
  WATCH_LATER
  WATCHING
  COMPLETED
}

enum VideoPlatform {
  YOUTUBE
  VIMEO
  UNIVERSITY_PORTAL
  OTHER
}

enum TaskType {
  ASSIGNMENT
  PROJECT
  EXAM
  QUIZ
  PRESENTATION
  READING
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum FocusSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// ---------------------------------------------------------------------------
// CORE IDENTITY
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  authUserId      String?  @unique // Supabase auth.users.id (UUID) — null until the account is claimed via sign-in
  name            String
  email           String   @unique
  profileSettings Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  semesters        Semester[]
  subjects         Subject[]
  flashcards       Flashcard[]
  reviewItems      ReviewItem[]
  problems         Problem[]
  mistakes         Mistake[]
  clinicalTraining ClinicalTraining[]
  procedures       Procedure[]
  videos           Video[]
  tasks            Task[]
  focusSessions    FocusSession[]
  documents        Document[]
  captures         CaptureItem[]
  timeCommitments  TimeCommitment[]
  scheduleEvents   ScheduleEvent[]
  events           StudentEvent[]
  preferences      StudentPreference[]
  studyPositions   StudyPosition[]
}

model Semester {
  id        String         @id @default(cuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// ACADEMIC STRUCTURE
// ---------------------------------------------------------------------------

model Subject {
  id          String        @id @default(cuid())
  userId      String
  semesterId  String
  name        String
  code        String?
  description String?
  color       String        @default("#6366f1")
  instructor  String?
  creditHours Int           @default(3)
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester        Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  topics          Topic[]
  lectures        Lecture[]
  knowledgeGaps   KnowledgeGap[]
  flashcards      Flashcard[]
  problems        Problem[]
  mistakes        Mistake[]
  procedures      Procedure[]
  videos          Video[]
  tasks           Task[]
  reviewItems     ReviewItem[]
  focusSessions   FocusSession[]
  documents       Document[]
  timeCommitments TimeCommitment[]
  scheduleEvents  ScheduleEvent[]
  events          StudentEvent[]

  @@index([userId])
  @@index([semesterId])
}

model Topic {
  id           String     @id @default(cuid())
  subjectId    String
  name         String
  description  String?
  difficulty   Difficulty @default(MEDIUM)
  masteryLevel Int        @default(0) // 0-100
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// The lecture that is "mainly" this, kept from before coverage existed.
  lectures      Lecture[]
  /// Every lecture that teaches this concept. See LectureTopic.
  taughtIn      LectureTopic[]
  knowledgeGaps KnowledgeGap[]
  flashcards    Flashcard[]
  problems      Problem[]
  mistakes      Mistake[]
  videos        Video[]
  reviewItems   ReviewItem[]

  @@index([subjectId])
}

model Lecture {
  id                   String        @id @default(cuid())
  subjectId            String
  topicId              String?
  title                String
  lectureNumber        Int           @default(1)
  date                 DateTime
  lecturer             String?
  status               LectureStatus @default(NOT_STARTED)
  completionPercentage Int           @default(0)
  difficultyRating     Int           @default(3) // 1-5
  quickNotes           String?
  selfAssessment       Int? // 0-100 student self-rated understanding
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic          Topic?            @relation(fields: [topicId], references: [id])
  /// Every concept this lecture covers. See LectureTopic.
  coveredTopics  LectureTopic[]
  resources      LectureResource[]
  knowledgeGaps  KnowledgeGap[]
  flashcards     Flashcard[]
  problems       Problem[]
  videos         Video[]
  reviewItems    ReviewItem[]
  mistakes       Mistake[]
  focusSessions  FocusSession[]
  slides         LectureSlide[]
  documents      Document[]
  scheduleEvents ScheduleEvent[]

  @@index([subjectId])
  @@index([topicId])
}

model LectureResource {
  id        String       @id @default(cuid())
  lectureId String
  type      ResourceType
  title     String
  url       String?
  filePath  String?
  createdAt DateTime     @default(now())


  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

// ---------------------------------------------------------------------------
// SLIDE ANNOTATION — upload a lecture slide (PDF/image) and draw on it
// ---------------------------------------------------------------------------

model LectureSlide {
  id         String   @id @default(cuid())
  lectureId  String
  documentId String? // links to the unified Document/file-intelligence layer (nullable: pre-Document rows keep working)
  title      String
  fileUrl    String
  fileType   String // "pdf" | "image"
  pageCount  Int      @default(1)
  createdAt  DateTime @default(now())


  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  lecture     Lecture           @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  document    Document?         @relation(fields: [documentId], references: [id])
  annotations SlideAnnotation[]
  positions   StudyPosition[]

  @@index([lectureId])
  @@index([documentId])
}

model SlideAnnotation {
  id         String   @id @default(cuid())
  slideId    String
  pageNumber Int      @default(1)
  strokes    Json
  updatedAt  DateTime @updatedAt

  slide LectureSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, pageNumber])
  @@index([slideId])
}

// ---------------------------------------------------------------------------
// FILE INTELLIGENCE — a single, reusable ingestion/processing layer for every
// uploaded file (lecture slides today; syllabi, assignments, clinical
// documents, and general Smart Capture uploads later). LectureSlide links to
// a Document via documentId instead of duplicating upload/processing logic;
// LectureResource is deliberately NOT migrated here — it's a metadata-only
// external link/citation record, not an uploaded file.
// ---------------------------------------------------------------------------

enum DocumentCategory {
  LECTURE
  SYLLABUS
  ASSIGNMENT
  CLINICAL
  NOTE
  IMAGE
  OTHER
}

enum DocumentProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id           String           @id @default(cuid())
  userId       String
  subjectId    String?
  lectureId    String?
  category     DocumentCategory @default(OTHER)
  originalName String
  storagePath  String // private, user-scoped Supabase Storage path
  mimeType     String
  sizeBytes    Int
  pageCount    Int?

  processingStatus DocumentProcessingStatus @default(UPLOADED)
  processingError  String?
  extractedText    String? // flattened full-text, for simple/future full-text consumers
  metadata         Json? // processor output: e.g. { pages: [{ pageNumber, text }], ocrProvider, wordCount }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?       @relation(fields: [subjectId], references: [id])
  lecture  Lecture?       @relation(fields: [lectureId], references: [id])
  slides   LectureSlide[]
  /// Procedures whose checklist was built from this file. A faculty procedure
  /// PDF is the one source a competitor cannot get hold of, so which document a
  /// checklist came from is worth keeping rather than flattening into text.
  procedures Procedure[]
  captures CaptureItem[]

  @@index([userId])
  @@index([subjectId])
  @@index([lectureId])
  @@index([processingStatus])
}

// ---------------------------------------------------------------------------
// KNOWLEDGE GAPS — the central intelligence layer
// ---------------------------------------------------------------------------

model KnowledgeGap {
  id                 String     @id @default(cuid())
  subjectId          String
  lectureId          String?
  topicId            String?
  clinicalTrainingId String?
  videoId            String?
  title              String
  description        String?
  source             GapSource  @default(OTHER)
  difficulty         Difficulty @default(MEDIUM)
  status             GapStatus  @default(NOT_UNDERSTOOD)
  createdAt          DateTime   @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime   @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecture          Lecture?          @relation(fields: [lectureId], references: [id])
  topic            Topic?            @relation(fields: [topicId], references: [id])
  clinicalTraining ClinicalTraining? @relation(fields: [clinicalTrainingId], references: [id])
  video            Video?            @relation(fields: [videoId], references: [id])
  flashcards       Flashcard[]
  reviewItems      ReviewItem[]
  problems         Problem[]
  mistakes         Mistake[]

  @@index([subjectId])
  @@index([lectureId])
  @@index([topicId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// FLASHCARDS — spaced repetition
// ---------------------------------------------------------------------------

model Flashcard {
  id             String  @id @default(cuid())
  userId         String
  subjectId      String
  lectureId      String?
  topicId        String?
  knowledgeGapId String?

  front String
  back  String

  difficulty Difficulty      @default(MEDIUM)
  status     FlashcardStatus @default(NEW)

  lastReviewed   DateTime?
  nextReviewDate DateTime  @default(now())
  intervalDays   Int       @default(0)
  easeFactor     Float     @default(2.5)

  reviewCount    Int @default(0)
  correctCount   Int @default(0)
  incorrectCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecture      Lecture?      @relation(fields: [lectureId], references: [id])
  topic        Topic?        @relation(fields: [topicId], references: [id])
  knowledgeGap KnowledgeGap? @relation(fields: [knowledgeGapId], references: [id])
  reviewItems  ReviewItem[]

  @@index([userId])
  @@index([subjectId])
  @@index([nextReviewDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// REVIEW SYSTEM
// ---------------------------------------------------------------------------

model ReviewItem {
  id        String  @id @default(cuid())
  userId    String
  subjectId String
  lectureId String?
  topicId   String?

  flashcardId    String?
  knowledgeGapId String?
  mistakeId      String?

  type          ReviewType
  scheduledDate DateTime
  reviewStage   ReviewStage  @default(REVIEW_1)
  status        ReviewStatus @default(SCHEDULED)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecture      Lecture?      @relation(fields: [lectureId], references: [id])
  topic        Topic?        @relation(fields: [topicId], references: [id])
  flashcard    Flashcard?    @relation(fields: [flashcardId], references: [id])
  knowledgeGap KnowledgeGap? @relation(fields: [knowledgeGapId], references: [id])
  mistake      Mistake?      @relation(fields: [mistakeId], references: [id])

  @@index([userId])
  @@index([scheduledDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// PROBLEM SOLVING
// ---------------------------------------------------------------------------

model Problem {
  id             String  @id @default(cuid())
  userId         String
  subjectId      String
  lectureId      String?
  topicId        String?
  knowledgeGapId String?

  question      String
  userAnswer    String?
  correctAnswer String

  difficulty Difficulty    @default(MEDIUM)
  status     ProblemStatus @default(NOT_ATTEMPTED)
  attempts   Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lecture      Lecture?      @relation(fields: [lectureId], references: [id])
  topic        Topic?        @relation(fields: [topicId], references: [id])
  knowledgeGap KnowledgeGap? @relation(fields: [knowledgeGapId], references: [id])
  mistakes     Mistake[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MISTAKE JOURNAL
// ---------------------------------------------------------------------------

model Mistake {
  id             String  @id @default(cuid())
  userId         String
  problemId      String?
  subjectId      String
  topicId        String?
  lectureId      String?
  knowledgeGapId String?

  /// The checklist step this miss was on, when it happened during a procedure.
  ///
  /// This is what finally gives `mistake-patterns.ts` something to read. That
  /// engine — and `frequency` on this model, and the repeated-weakness banner —
  /// were all built to answer "what do I keep getting wrong", and then starved:
  /// the only way to create a Mistake was a form that was never filled in once
  /// in twenty-four days. A missed OSPE step is the same fact in a shape a
  /// student will actually record, because they record it by ticking a box
  /// rather than by writing an essay.
  ///
  /// Null for a mistake that was not made during a procedure, and null again if
  /// the step is later removed from the checklist: the record that something
  /// was missed outlives the edit, with `whyIGotItWrong` still readable.
  procedureStepId String?

  mistakeType       MistakeType
  whyIGotItWrong    String?
  correctConcept    String?
  whatIShouldReview String?
  frequency         Int           @default(1)
  status            MistakeStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem?      @relation(fields: [problemId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        Topic?        @relation(fields: [topicId], references: [id])
  lecture      Lecture?      @relation(fields: [lectureId], references: [id])
  knowledgeGap KnowledgeGap? @relation(fields: [knowledgeGapId], references: [id])
  procedureStep ProcedureStep? @relation(fields: [procedureStepId], references: [id], onDelete: SetNull)
  reviewItems  ReviewItem[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CLINICAL TRAINING
// ---------------------------------------------------------------------------

model ClinicalTraining {
  id     String @id @default(cuid())
  userId String

  date            DateTime
  /// How long the shift actually ran. Nullable: older entries genuinely do
  /// not know, and a shift of unknown length must not be counted as zero
  /// hours when working out what time a day really had left in it.
  durationMinutes Int?
  hospital        String?
  department      String?
  supervisor      String?

  skillsPracticed       String?
  casesSeen             Int     @default(0)
  whatILearned          String?
  whatIDidNotUnderstand String?
  questionsToAsk        String?
  reflection            String?
  nextAction            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeGaps  KnowledgeGap[]
  scheduleEvents ScheduleEvent[]

  @@index([userId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// VIDEO LEARNING LIBRARY
// ---------------------------------------------------------------------------

model Video {
  id        String  @id @default(cuid())
  userId    String
  subjectId String?
  lectureId String?
  topicId   String?

  title    String
  url      String
  platform VideoPlatform @default(YOUTUBE)
  duration Int? // seconds
  status   VideoStatus   @default(WATCH_LATER)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  lecture       Lecture?       @relation(fields: [lectureId], references: [id])
  topic         Topic?         @relation(fields: [topicId], references: [id])
  knowledgeGaps KnowledgeGap[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ASSIGNMENTS & DEADLINES
// ---------------------------------------------------------------------------

model Task {
  id        String  @id @default(cuid())
  userId    String
  subjectId String?

  title       String
  description String?
  type        TaskType     @default(ASSIGNMENT)
  deadline    DateTime
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(NOT_STARTED)

  completionPercentage Int @default(0)

  /// How long this realistically takes, in minutes. Nullable on purpose: a
  /// task nobody has estimated is *unknown*, and the planner reports it as
  /// unknown rather than substituting an average that would quietly turn a
  /// guess into a schedule.
  estimatedMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which dropped item created this, when the agent created it. Null for
  /// anything the student made themselves — which is the whole point: "undo
  /// this drop" must never remove work that was not the agent's.
  sourceCaptureId String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  scheduleEvents ScheduleEvent[]
  events         StudentEvent[]

  @@index([userId])
  @@index([deadline])
  @@index([status])
}

// ---------------------------------------------------------------------------
// FOCUS MODE
// ---------------------------------------------------------------------------

model FocusSession {
  id        String  @id @default(cuid())
  userId    String
  subjectId String?
  lectureId String?
  taskLabel String?

  /// Where the target came from: TASK | CARD | GAP | LECTURE_SECTION | FREE | NONE.
  ///
  /// The instrument, not the feature. Measured on the real account: both
  /// sessions that finished had a target the app had written from one of the
  /// student's records, and all seven abandonments had none or a free-typed
  /// one. That is n=2, below patterns.ts's MIN_OBSERVATIONS of 4, so nothing
  /// is concluded from it yet — this column is what makes it concludable.
  /// Null means the session predates the column and is never backfilled by
  /// inference. A CHECK constraint enforces the values rather than an enum, so
  /// the list can grow without a lock and a redeploy.
  targetKind  String?
  /// The row the target points at. Required for the four record-backed kinds
  /// and forbidden for FREE and NONE — enforced in the database too, because
  /// a label that reads specific with nothing behind it is the exact failure
  /// this prevents.
  targetRefId String?

  plannedMinutes Int
  actualMinutes  Int?
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  status         FocusSessionStatus @default(ACTIVE)

  accomplished  String?
  notUnderstood String?
  toReview      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?       @relation(fields: [subjectId], references: [id])
  lecture Lecture?       @relation(fields: [lectureId], references: [id])
  events  StudentEvent[]

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CAPTURE — the "drop anything" inbox
// ---------------------------------------------------------------------------

enum CaptureKind {
  TEXT
  FILE
}

enum CaptureStatus {
  PENDING // accepted, not yet looked at
  ANALYZING // an AI provider is working on it
  NEEDS_REVIEW // analysed, but the user must confirm before anything is created
  ORGANIZED // the user confirmed; destinations were created
  FAILED // analysis could not complete; `error` says why
  UNPROCESSED // no AI provider is configured, so it is filed but not analysed
}

/// One item dropped into the inbox before the student has decided what it is.
///
/// The whole point is that dropping is free: nothing here requires a subject,
/// a lecture, or a type up front. Those are what the analysis step proposes
/// and the student confirms.
///
/// Files are not duplicated — a FILE capture points at a Document, which
/// already owns storage, extraction and its own processing lifecycle. This
/// model adds only what Document has no concept of: the raw text of a thought,
/// and the proposed organisation awaiting confirmation.
/// A clinical procedure and the ordered steps it is marked on.
///
/// WHAT THIS REPLACES. `ClinicalTraining` has been in the schema since the
/// first week, is one of the five top-level destinations, and holds ZERO rows
/// after twenty-four days of real use. Its columns say why: hospital,
/// department, supervisor, skillsPracticed, whatILearned, questionsToAsk,
/// reflection, nextAction — a reflective journal asking for five essays at the
/// end of an eight-hour shift. The form cost more than it returned.
///
/// An OSPE is not a journal. An examiner says "insert a nasogastric tube" and
/// marks the steps performed and omitted, so the unit is a procedure and its
/// ordered steps, and the fact worth keeping is WHICH step was missed. Scoring
/// lives in src/lib/ospe.ts, where an omitted critical step fails the station
/// regardless of the total — which is why eighteen right out of twenty can
/// still be a fail, and why a percentage is the wrong shape of answer.
///
/// `ClinicalTraining` is left in place: it is empty, so nothing is at stake in
/// dropping it and nothing is gained either.
model Procedure {
  id        String  @id @default(cuid())
  userId    String
  subjectId String?

  name String

  /// The document this checklist was built from. A procedure taken from the
  /// student's own faculty PDF is worth more than one written from a model's
  /// memory, and storing the source is what lets the interface say which it is
  /// instead of presenting both alike.
  sourceDocumentId String?

  /// The same stamp every agent write carries, so a procedure created by a
  /// drop is undone by the same path as everything else that drop created.
  sourceCaptureId String?

  /// Null means never practised — a different fact from practised long ago,
  /// and ordered differently. See practiceOrder in src/lib/ospe.ts.
  lastPracticedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: a checklist is the student's own work and outlives
  /// the course it was filed under. Losing the filing is an inconvenience;
  /// losing the checklist is losing the thing they built.
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  steps    ProcedureStep[]

  @@index([userId])
  @@index([subjectId])
  @@index([sourceCaptureId])
}

/// One step of a procedure, in the order it is performed.
model ProcedureStep {
  id          String @id @default(cuid())
  procedureId String

  /// Named `position` rather than `order`, which is a reserved word in SQL and
  /// would need quoting in every hand-written query from here on.
  position Int

  text String

  /// A step whose omission fails the station on its own.
  ///
  /// Set by the student from their own faculty's checklist and never inferred.
  /// Which steps are critical is a marking convention that differs between
  /// schools and between procedures, and guessing it would be the app
  /// inventing the rule it then judges them by.
  critical Boolean @default(false)

  createdAt DateTime @default(now())

  /// Cascade here and only here: a step has no meaning apart from its
  /// procedure, so deleting the procedure and keeping the steps would leave
  /// rows nothing can reach.
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  mistakes  Mistake[]

  /// Two steps of one procedure cannot share a position. Without this the
  /// order shown is whatever the planner returns, and for a procedure the
  /// order IS the content — step 5 before step 4 is a different, sometimes
  /// unsafe act.
  @@unique([procedureId, position])
  @@index([procedureId, position])
}

model CaptureItem {
  id     String      @id @default(cuid())
  userId String
  kind   CaptureKind

  /// Present for TEXT captures: a pasted note, a question, a passing thought.
  text String?

  /// Present for FILE captures. The Document owns the bytes and the text
  /// extraction; this row owns only what to do with the result.
  documentId String?

  status CaptureStatus @default(PENDING)

  /// The provider's proposal, kept as written so it stays inspectable and is
  /// never silently promoted into real records: detected subject and topics,
  /// suggested destinations, and a confidence the UI uses to decide whether to
  /// ask before acting. Null until an analysis has actually run.
  analysis Json?

  /// Which provider and model produced `analysis`, so a proposal can always be
  /// traced back to what made it.
  analyzedBy String?

  /// What the agent actually did, one entry per tool call that succeeded, with
  /// the real id of every row it created.
  ///
  /// This is a record, not a plan. It is written *after* the writes land, from
  /// their return values, so it can only ever describe things that exist. The
  /// interface reads this and nothing else when it tells the student what
  /// happened — which is what makes "I added 6 lectures to your week" a fact
  /// the student can go and check rather than a sentence a model composed.
  agentActions Json?

  /// The agent's own closing sentence, in the student's language.
  ///
  /// Separate from `agentActions` because it is the one part of the outcome
  /// the model authors freely. It explains; it never establishes. If the two
  /// ever disagree, the actions are true and this is prose.
  agentSummary String?

  /// What reading the rows back turned up — a deadline whose year looks
  /// misread, a class at 3am, a second course with almost the student's own
  /// course name. Codes, not sentences, because the sentence has to be in the
  /// student's language and the server does not know it.
  ///
  /// Null means the review never ran for this row; an empty array means it ran
  /// and found nothing. Those are different facts.
  reviewNotes Json?

  /// A timetable import waiting for the student to confirm the week is right.
  ///
  /// The one call that turns a single photo into dozens of rows, replaces what
  /// the last import claimed, and — because every calculation about their free
  /// time rests on it — corrupts far more than itself when the times are read
  /// wrong. Everything else the agent does creates one or a few rows and is
  /// undoable on its own; this is held instead. Null means nothing is waiting.
  pendingWrites Json?

  /// How far through a long document the reading has got.
  ///
  /// A textbook is the largest and most important file a student owns, and it
  /// used to have its first few pages read and the rest silently ignored —
  /// reported as a success. Long documents are now read across several passes;
  /// this is what lets the next one pick up where the last stopped. Null for
  /// anything that fitted in a single pass, which is almost everything.
  readingProgress Json?

  error String?

  /// What every agent run against this item has cost, in dollars, accumulated.
  ///
  /// The agent has always counted spend — each response carries a usage block
  /// and spend.ts folds them into a total — and always threw the total away
  /// into a console log. That made the numbers right and unusable: a log
  /// cannot be summed, so no day could be capped and no student could be told
  /// what their day cost.
  ///
  /// Accumulated rather than set, because one item can be run many times: a
  /// long document is read across several passes, and the PDF fallback runs
  /// twice inside a single request. The writer increments.
  ///
  /// Null means the run happened before this column existed. Not zero — six
  /// of the fourteen existing rows really did call the model — so any sum over
  /// this column excludes nulls rather than treating them as free.
  costUsd Float?

  /// Wall-clock milliseconds the agent run took, written once when it
  /// finishes. Nullable and never zero: a run that was refused by the budget,
  /// never started, or predates this column has no duration, and writing 0
  /// would turn "never measured" into "took no time" — the same distinction
  /// `costUsd` draws.
  ///
  /// It exists because nothing else could answer "how long does this take".
  /// `updatedAt - createdAt` looks like it would and does not: it moves on
  /// every later write, and on the real account that proxy ranged from 14
  /// seconds to twenty days for work that took under a minute. An estimate
  /// shown to a student has to come from a measurement, not from a column
  /// that happens to be a timestamp.
  durationMs      Int?

  /// Set when the student confirms the proposal and the destinations are
  /// created. Until then nothing has been written to their academic records.
  organizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// TIME INTELLIGENCE
// ---------------------------------------------------------------------------

enum CommitmentKind {
  SLEEP
  UNIVERSITY // lectures, labs, tutorials — the timetable itself
  CLINICAL
  COMMUTE
  MEALS
  WORK
  PERSONAL
}

/// A recurring block of the week that is already spoken for.
///
/// This model exists because "you have 7 realistic hours today" is either a
/// real number or a lie, and nothing in the schema could previously make it
/// real: `Lecture.date` and `ClinicalTraining.date` are bare timestamps with
/// no duration, so the hours a student is actually in a building were never
/// represented anywhere. Available time can only ever be computed by
/// subtracting commitments the system genuinely knows about.
///
/// Every row here was either entered by the student or extracted from a
/// timetable they dropped in and then confirmed — never inferred, and never
/// invented to make a calculation look complete.
model TimeCommitment {
  id     String @id @default(cuid())
  userId String

  kind  CommitmentKind
  /// What the student calls it ("Pharmacology lab", "Commute"). Optional:
  /// the kind alone is often enough, and forcing a name is friction.
  label String?

  /// 0 = Sunday … 6 = Saturday, matching `Date.getDay()`. Null means every
  /// day, which is what sleep and meals actually are.
  weekday Int?

  /// Minutes from local midnight, 0–1439. When `endMinute` is less than or
  /// equal to `startMinute` the block crosses midnight (23:00 → 07:00 sleep
  /// is the normal case, not an edge case) and the engine splits it.
  startMinute Int
  endMinute   Int

  /// Set when this came from a dropped and confirmed timetable, so a block
  /// can always be traced back to the thing the student handed over.
  sourceCaptureId String?

  subjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, weekday])
}

// ---------------------------------------------------------------------------
// SCHEDULE EVENTS — the dated half of the time foundation
// ---------------------------------------------------------------------------

enum ScheduleEventType {
  LECTURE
  CLINICAL
  /// A tutorial or section — "TUT" on a King Abdulaziz nursing timetable.
  /// Added because three of the five session types on a real student's real
  /// timetable had no value here and all collapsed into OTHER, which rendered
  /// a Wednesday of lecture / activity / lecture / tutorial as two identical
  /// grey blocks. How you prepare for a tutorial is not how you prepare for a
  /// lecture, so they cannot look the same.
  TUTORIAL
  /// A practical lab session — "Lab".
  LAB
  /// Scheduled non-teaching time the faculty puts on the timetable —
  /// "Activity". It occupies the slot, so it belongs on the grid.
  ACTIVITY
  EXAM
  QUIZ
  ASSIGNMENT
  DEADLINE
  STUDY_SESSION
  PERSONAL
  OTHER
}

/// Where an event came from, so a calendar entry can always be traced back to
/// the thing that produced it — and so an imported timetable can be re-imported
/// without duplicating what the student typed by hand.
enum ScheduleEventSource {
  STUDENT
  TIMETABLE_IMPORT
  LECTURE_RECORD
  CLINICAL_RECORD
  RECURRENCE
}

/// One thing happening at one specific time.
///
/// This is the counterpart to TimeCommitment, not a replacement for it:
/// TimeCommitment describes a *pattern* ("university, every Tuesday, 08:00 to
/// 14:00"), while this describes an *occurrence* ("Pharmacology exam, 20
/// September, 09:00"). Available time needs both — the recurring shape of a
/// normal week, and the specific things that land in it.
///
/// Deliberately additive: nothing in Lecture or ClinicalTraining changes.
/// Those models keep owning what they always owned; this owns *when*, which
/// neither of them could express, since both carry a bare `date` with no
/// duration.
model ScheduleEvent {
  id     String @id @default(cuid())
  userId String

  title String
  type  ScheduleEventType

  startsAt DateTime

  /// Null means the event is an instant rather than a span — a deadline is a
  /// moment, and consumes no time on the calendar. Setting this equal to
  /// `startsAt` instead would invent a zero-length block, so the database
  /// rejects that: the check is `endsAt IS NULL OR endsAt > startsAt`.
  ///
  /// Duration is derived from the two, never stored. Storing it as well would
  /// give two sources of truth that quietly disagree the first time an event
  /// is edited.
  endsAt DateTime?

  location String?

  source          ScheduleEventSource @default(STUDENT)
  /// Set when this came from something the student dropped in and confirmed.
  sourceCaptureId String?

  /// Every link is optional and severs to null rather than cascading: an event
  /// can stand alone, and deleting a lecture must not silently erase the
  /// record that time was spent.
  subjectId  String?
  lectureId  String?
  clinicalId String?
  taskId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lecture  Lecture?          @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  clinical ClinicalTraining? @relation(fields: [clinicalId], references: [id], onDelete: SetNull)
  task     Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([subjectId])
  @@index([lectureId])
  @@index([clinicalId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// PERSONAL STUDENT INTELLIGENCE — what actually happened, and nothing else
// ---------------------------------------------------------------------------

/// Things the student did that the product can observe.
///
/// Every member names an action, not a trait. There is no BAD_DAY, no
/// PROCRASTINATED and no UNMOTIVATED, because those are readings of a person
/// rather than records of an event — and a system that stores a reading will
/// eventually show it back to the student as a fact about who they are.
enum StudentEventType {
  SESSION_STARTED
  SESSION_COMPLETED
  SESSION_ABANDONED
  TASK_COMPLETED
  TASK_POSTPONED
  /// The student said how their energy was, in the moment they were asked.
  ENERGY_SELECTED
  /// "I don't understand this", said during a session.
  STUDENT_STUCK
  RECOVERY_USED
  HELP_USED
  SUGGESTION_ACCEPTED
  SUGGESTION_DECLINED

  /// The student took back everything one drop wrote. The strongest correction
  /// there is: not "this row is wrong" but "none of that was right".
  DROP_UNDONE
  /// They renamed a course the agent named — usually because it read the name
  /// off a file header instead of the course's actual title.
  AGENT_COURSE_RENAMED
  /// They deleted something the agent created, one row at a time.
  AGENT_ROW_DELETED
}

/// One observed thing, at one moment. Append-only.
///
/// This is the only new place behaviour is written, and it is deliberately a
/// log rather than a profile. Patterns — "mornings usually go better", "this
/// assignment keeps getting moved" — are recomputed from these rows every
/// time they are needed, never stored. A stored conclusion outlives the
/// behaviour that produced it, so a student who changes stays labelled by
/// who they were a month ago.
///
/// Immutability is enforced in the database, not just intended here: the
/// table has SELECT, INSERT and DELETE policies and no UPDATE policy, so a
/// recorded event cannot be rewritten after the fact. DELETE is allowed on
/// purpose — the student must be able to erase their own history.
model StudentEvent {
  id     String           @id @default(cuid())
  userId String
  type   StudentEventType

  occurredAt DateTime @default(now())

  /// Every link is optional and severs to null rather than cascading:
  /// deleting a task must not erase the record that time was spent on it.
  taskId         String?
  focusSessionId String?
  subjectId      String?

  /// The few numbers that make the event readable later — planned and actual
  /// minutes, the energy that was chosen, how far a deadline moved. Small and
  /// specific on purpose: this is not a place to accumulate everything that
  /// happened to be in scope.
  context Json?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  session FocusSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([taskId])
  @@index([focusSessionId])
  @@index([subjectId])
}

/// What the student has decided about personalisation.
///
/// Deliberately a key/value table and not a widening row of boolean columns:
/// new columns on an existing model are the change shape that breaks every
/// query against an unmigrated database, and preferences are exactly the kind
/// of thing that gets added to one at a time.
model StudentPreference {
  id     String @id @default(cuid())
  userId String

  key   String
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Where the student actually is in a document.
///
/// The product is supposed to say "you stopped at slide 18" and carry on from
/// nineteen. Before this there was no field anywhere in the schema that could
/// answer that, so every deck opened at page one — the one behaviour the target
/// architecture names as wrong.
///
/// A table rather than two columns on LectureSlide, and that is not a style
/// choice: Prisma builds its column list from this file rather than from the
/// query, so a new column on an existing model makes every default query on
/// that model ask Postgres for it, and against a database where the migration
/// has not run, every route touching the model fails. That already cost this
/// app an outage once, with Task.estimatedMinutes. A new table's blast radius
/// is only the code that reads it.
///
/// Mutable, unlike StudentEvent: position is a fact about the present, not a
/// record of what happened. See prisma/sql/2026_study_position.sql.
model StudyPosition {
  id     String @id @default(cuid())
  userId String

  /// The deck, because a deck is the unit a student resumes: a lecture can
  /// carry several, and "continue" has to mean the one they were reading.
  slideId String

  /// Where they stopped, and the furthest they have reached. Both, because
  /// they answer different questions — and because a student who flicks back
  /// to check something must not lose their progress by doing so.
  lastPage     Int @default(1)
  furthestPage Int @default(1)

  /// What "recent learning" is ordered by.
  lastViewedAt DateTime @default(now())

  /// Set when the last page is reached. A date rather than a flag: when they
  /// finished is worth knowing, and "never" is simply its absence.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slide LectureSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([userId, slideId])
  @@index([userId, lastViewedAt])
  @@index([slideId])
}

/// Which concepts a lecture actually teaches.
///
/// `Lecture.topicId` is a single foreign key, and it was modelling a
/// many-to-many reality: a lecture covers dozens of concepts, and a concept
/// ("PEEP") is taught across several lectures. Asked to name the ONE topic it
/// sat under, every lecture on the real account stored null - 46 topics empty,
/// 6 lectures unfiled. Matching lecture titles against topic names gives
/// 0, 0, 0, 0, 7, 2: never exactly one, which is the signature of the
/// inversion. `topicId` is kept and still works; coverage lives here.
model LectureTopic {
  lectureId String
  topicId   String

  /// TEXT    - decided by src/lib/concept-match.ts from the lecture's own text
  /// AGENT   - asserted by the agent from dropped content
  /// STUDENT - made by hand, and never overwritten by an automated pass
  source String @default("TEXT")

  /// What concept-match.ts scored it, so a threshold change can be evaluated
  /// against links already written rather than guessed at.
  score Float?

  /// Which dropped item produced this. Same contract as Lecture.sourceCaptureId:
  /// "undo this drop" must never remove a link the student made themselves.
  sourceCaptureId String?

  createdAt DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([lectureId, topicId])
  @@index([topicId])
  @@index([sourceCaptureId])
}
