# Postgres connection (Supabase). Use the Supavisor pooler host, not the
# direct db.<ref>.supabase.co host — the direct host is IPv6-only and most
# serverless platforms (Netlify Functions included) can't reach it.
# connection_limit should comfortably cover the most concurrent queries a
# single request fires (several pages run Promise.all across many tables).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Supabase project — used for Auth (login/register/session) and Storage
# (private per-user lecture slide uploads). The anon/publishable key is
# NOT secret (Supabase designs it to be shipped to the browser); it only
# works within whatever your RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Required ONLY for the background file-processing job
# (netlify/functions/process-documents.mts). That job runs outside any
# user's session, so it can't use a per-user access token like the rest
# of the app — it needs the service role key, which bypasses Storage RLS
# by design. Get it from Supabase dashboard → Project Settings → API →
# service_role. THIS IS A SECRET — never expose it to the browser, never
# prefix it with NEXT_PUBLIC_, and mark it "secret" in Netlify.
# Without it, uploaded documents stay QUEUED (never processed, never
# incorrectly marked FAILED) until this is set.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
