# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma sqlite database (regenerate via `npx prisma migrate dev` + `npm run db:seed`)
/prisma/dev.db
/prisma/dev.db-journal
/prisma/prisma/
shots/

# Copied out of node_modules by scripts/copy-pdfjs-assets.mjs before every build.
/public/pdfjs

# Fixtures for a local walkthrough only; never part of the product.
/public/local-test
